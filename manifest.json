{
    "manifest_version": 3,
    "name": "Site Focus Timer",
    "version": "1.0",
    "description": "When u need to focus block distracting sites",
    "permissions": [
        "storage",
        "declarativeNetRequest"
    ],
    "host_permissions": [
        "<all_urls"
    ],
    "action":{
        "default_popup":"popup.html"
    }
}